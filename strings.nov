// ---------------------------------------------------------------------------
// std/strings - cross-platform string operations (no assembly, no syscalls)
// ---------------------------------------------------------------------------

module std_strings;

import core;

fn read_byte(addr: u64) -> i32 {
    let w: i32 = load32(addr);
    let b: i32 = w % 256;
    if (b < 0) { b = b + 256; }
    return b;
}

fn cstr_len(addr: u64) -> u64 {
    let i: u64 = 0;
    while (i < 4096) {
        if (read_byte(addr + i) == 0) { return i; }
        i = i + 1;
    }
    return i;
}

fn starts_with(s: str, p: str) -> bool {
    if (len(s) < len(p)) { return false; }
    let i: i32 = 0;
    let sptr: u64 = ptr(s);
    let pp: u64 = ptr(p);
    while (i < len(p)) {
        let off: u64 = i32_to_u64(i);
        if (read_byte(sptr + off) != read_byte(pp + off)) { return false; }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: str, p: str) -> bool {
    let sl: i32 = len(s);
    let pl: i32 = len(p);
    if (sl < pl) { return false; }
    let off: i32 = sl - pl;
    let sptr: u64 = ptr(s);
    let pp: u64 = ptr(p);
    let i: i32 = 0;
    while (i < pl) {
        let si: i32 = off + i;
        if (read_byte(sptr + i32_to_u64(si)) != read_byte(pp + i32_to_u64(i))) { return false; }
        i = i + 1;
    }
    return true;
}

fn str_contains(s: str, needle: str) -> bool {
    let sl: i32 = len(s);
    let nl: i32 = len(needle);
    if (nl == 0) { return true; }
    if (sl < nl) { return false; }
    let limit: i32 = sl - nl + 1;
    let sptr: u64 = ptr(s);
    let np: u64 = ptr(needle);
    let i: i32 = 0;
    while (i < limit) {
        let ok: bool = true;
        let j: i32 = 0;
        while (j < nl) {
            let ci: i32 = i + j;
            if (read_byte(sptr + i32_to_u64(ci)) != read_byte(np + i32_to_u64(j))) { ok = false; j = nl; }
            else { j = j + 1; }
        }
        if (ok) { return true; }
        i = i + 1;
    }
    return false;
}

fn str_find(s: str, needle: str) -> i32 {
    let sl: i32 = len(s);
    let nl: i32 = len(needle);
    if (nl == 0) { return 0; }
    if (sl < nl) { return -1; }
    let limit: i32 = sl - nl + 1;
    let sptr: u64 = ptr(s);
    let np: u64 = ptr(needle);
    let i: i32 = 0;
    while (i < limit) {
        let ok: bool = true;
        let j: i32 = 0;
        while (j < nl) {
            let ci: i32 = i + j;
            if (read_byte(sptr + i32_to_u64(ci)) != read_byte(np + i32_to_u64(j))) { ok = false; j = nl; }
            else { j = j + 1; }
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

fn _byte_to_char(val: i32) -> str {
    let c: str = " ";
    store8(ptr(c), val);
    return c;
}

fn substr(s: str, start: i32) -> str {
    let slen: i32 = len(s);
    if (start >= slen) { return ""; }
    let count: i32 = slen - start;
    if (count <= 0) { return ""; }
    let sbase: u64 = ptr(s);
    let soff: u64 = i32_to_u64(start);
    return copy_bytes_raw(sbase + soff, count);
}

fn substr_len(s: str, start: i32, count: i32) -> str {
    let slen: i32 = len(s);
    if (start >= slen) { return ""; }
    if (start + count > slen) { count = slen - start; }
    if (count <= 0) { return ""; }
    let sbase: u64 = ptr(s);
    let soff: u64 = i32_to_u64(start);
    return copy_bytes_raw(sbase + soff, count);
}

// ---------------------------------------------------------------------------
// Find last occurrence of needle in s, returns -1 if not found
// ---------------------------------------------------------------------------

fn str_last_find(s: str, needle: str) -> i32 {
    let sl: i32 = len(s);
    let nl: i32 = len(needle);
    if (nl == 0) { return sl; }
    if (sl < nl) { return -1; }
    let sptr: u64 = ptr(s);
    let np: u64 = ptr(needle);
    let i: i32 = sl - nl;
    while (i >= 0) {
        let ok: bool = true;
        let j: i32 = 0;
        while (j < nl) {
            let ci: i32 = i + j;
            if (read_byte(sptr + i32_to_u64(ci)) != read_byte(np + i32_to_u64(j))) { ok = false; j = nl; }
            else { j = j + 1; }
        }
        if (ok) { return i; }
        i = i - 1;
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Count non-overlapping occurrences of needle in s
// ---------------------------------------------------------------------------

fn str_count(s: str, needle: str) -> i32 {
    let sl: i32 = len(s);
    let nl: i32 = len(needle);
    if (nl == 0) { return 0; }
    if (sl < nl) { return 0; }
    let count: i32 = 0;
    let sptr: u64 = ptr(s);
    let np: u64 = ptr(needle);
    let i: i32 = 0;
    let limit: i32 = sl - nl + 1;
    while (i < limit) {
        let ok: bool = true;
        let j: i32 = 0;
        while (j < nl) {
            let ci: i32 = i + j;
            if (read_byte(sptr + i32_to_u64(ci)) != read_byte(np + i32_to_u64(j))) { ok = false; j = nl; }
            else { j = j + 1; }
        }
        if (ok) {
            count = count + 1;
            i = i + nl;
        } else {
            i = i + 1;
        }
    }
    return count;
}

// ---------------------------------------------------------------------------
// Replace all occurrences of old with new_val in s
// ---------------------------------------------------------------------------

fn str_replace(s: str, old: str, new_val: str) -> str {
    let ol: i32 = len(old);
    if (ol == 0) { return s; }
    let sl: i32 = len(s);
    let sptr: u64 = ptr(s);
    let op: u64 = ptr(old);
    let result: str = "";
    let i: i32 = 0;
    while (i < sl) {
        let found: bool = false;
        if (i + ol <= sl) {
            found = true;
            let j: i32 = 0;
            while (j < ol) {
                let ci: i32 = i + j;
                if (read_byte(sptr + i32_to_u64(ci)) != read_byte(op + i32_to_u64(j))) { found = false; j = ol; }
                else { j = j + 1; }
            }
        }
        if (found) {
            result = result + new_val;
            i = i + ol;
        } else {
            result = result + _byte_to_char(read_byte(sptr + i32_to_u64(i)));
            i = i + 1;
        }
    }
    return result;
}

// Replace only the first occurrence
fn str_replace_first(s: str, old: str, new_val: str) -> str {
    let pos: i32 = str_find(s, old);
    if (pos < 0) { return s; }
    let ol: i32 = len(old);
    return substr_len(s, 0, pos) + new_val + substr(s, pos + ol);
}

// ---------------------------------------------------------------------------
// Trim whitespace
// ---------------------------------------------------------------------------

fn str_trim_left(s: str) -> str {
    let sl: i32 = len(s);
    let sptr: u64 = ptr(s);
    let i: i32 = 0;
    while (i < sl) {
        let ch: i32 = read_byte(sptr + i32_to_u64(i));
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
            i = i + 1;
        } else {
            break;
        }
    }
    return substr(s, i);
}

fn str_trim_right(s: str) -> str {
    let sl: i32 = len(s);
    let sptr: u64 = ptr(s);
    let i: i32 = sl - 1;
    while (i >= 0) {
        let ch: i32 = read_byte(sptr + i32_to_u64(i));
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
            i = i - 1;
        } else {
            break;
        }
    }
    return substr_len(s, 0, i + 1);
}

fn str_trim(s: str) -> str {
    return str_trim_right(str_trim_left(s));
}

// ---------------------------------------------------------------------------
// Case conversion (ASCII only)
// ---------------------------------------------------------------------------

fn str_upper(s: str) -> str {
    let sl: i32 = len(s);
    if (sl == 0) { return ""; }
    let result: str = copy_bytes_raw(ptr(s), sl);
    let rp: u64 = ptr(result);
    let sptr: u64 = ptr(s);
    let i: i32 = 0;
    while (i < sl) {
        let ch: i32 = read_byte(sptr + i32_to_u64(i));
        if (ch >= 97 && ch <= 122) {
            store8(rp + i32_to_u64(i), ch - 32);
        }
        i = i + 1;
    }
    return result;
}

fn str_lower(s: str) -> str {
    let sl: i32 = len(s);
    if (sl == 0) { return ""; }
    let result: str = copy_bytes_raw(ptr(s), sl);
    let rp: u64 = ptr(result);
    let sptr: u64 = ptr(s);
    let i: i32 = 0;
    while (i < sl) {
        let ch: i32 = read_byte(sptr + i32_to_u64(i));
        if (ch >= 65 && ch <= 90) {
            store8(rp + i32_to_u64(i), ch + 32);
        }
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Reverse a string
// ---------------------------------------------------------------------------

fn str_reverse(s: str) -> str {
    let sl: i32 = len(s);
    if (sl == 0) { return ""; }
    let result: str = make_buffer(sl);
    let rp: u64 = ptr(result);
    let sptr: u64 = ptr(s);
    let i: i32 = 0;
    while (i < sl) {
        let ch: i32 = read_byte(sptr + i32_to_u64(sl - 1 - i));
        store8(rp + i32_to_u64(i), ch);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Character classification (ASCII)
// ---------------------------------------------------------------------------

fn is_digit(ch: i32) -> bool {
    let c: i32 = ch & 255;
    return (c >= 48 && c <= 57);
}

fn is_alpha(ch: i32) -> bool {
    let c: i32 = ch & 255;
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

fn is_alnum(ch: i32) -> bool {
    return is_digit(ch) || is_alpha(ch);
}

fn is_space(ch: i32) -> bool {
    let c: i32 = ch & 255;
    return (c == 32 || c == 9 || c == 10 || c == 13);
}

fn is_upper(ch: i32) -> bool {
    let c: i32 = ch & 255;
    return (c >= 65 && c <= 90);
}

fn is_lower(ch: i32) -> bool {
    let c: i32 = ch & 255;
    return (c >= 97 && c <= 122);
}

// ---------------------------------------------------------------------------
// Padding
// ---------------------------------------------------------------------------

fn str_pad_left(s: str, total: i32, pad: str) -> str {
    let sl: i32 = len(s);
    if (sl >= total) { return s; }
    let result: str = "";
    let needed: i32 = total - sl;
    let i: i32 = 0;
    while (i < needed) {
        result = result + pad;
        i = i + 1;
    }
    return result + s;
}

fn str_pad_right(s: str, total: i32, pad: str) -> str {
    let sl: i32 = len(s);
    if (sl >= total) { return s; }
    let result: str = s;
    let needed: i32 = total - sl;
    let i: i32 = 0;
    while (i < needed) {
        result = result + pad;
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// String repetition check
// ---------------------------------------------------------------------------

fn str_equals(a: str, b: str) -> bool {
    let al: i32 = len(a);
    let bl: i32 = len(b);
    if (al != bl) { return false; }
    let ap: u64 = ptr(a);
    let bp: u64 = ptr(b);
    let i: i32 = 0;
    while (i < al) {
        let off: u64 = i32_to_u64(i);
        if (read_byte(ap + off) != read_byte(bp + off)) { return false; }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Split string at first occurrence of delimiter
// Returns the part before the delimiter. Use str_find + substr to get after.
// ---------------------------------------------------------------------------

fn str_split_first(s: str, delim: str) -> str {
    let pos: i32 = str_find(s, delim);
    if (pos < 0) { return s; }
    return substr_len(s, 0, pos);
}

fn str_split_rest(s: str, delim: str) -> str {
    let pos: i32 = str_find(s, delim);
    if (pos < 0) { return ""; }
    return substr(s, pos + len(delim));
}

// ---------------------------------------------------------------------------
// Check if string is empty or whitespace-only
// ---------------------------------------------------------------------------

fn str_is_empty(s: str) -> bool {
    return len(s) == 0;
}

fn str_is_blank(s: str) -> bool {
    let sl: i32 = len(s);
    let sptr: u64 = ptr(s);
    let i: i32 = 0;
    while (i < sl) {
        let ch: i32 = read_byte(sptr + i32_to_u64(i));
        if (ch != 32 && ch != 9 && ch != 10 && ch != 13) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Convert integer to hex string
// ---------------------------------------------------------------------------

fn int_to_hex(n: i32) -> str {
    if (n == 0) { return "0"; }
    let val: i32 = n;
    if (val < 0) { val = 0 - val; }
    let digits: str = "";
    while (val > 0) {
        let d: i32 = val % 16;
        if (d == 0) { digits = digits + "0"; }
        else if (d == 1) { digits = digits + "1"; }
        else if (d == 2) { digits = digits + "2"; }
        else if (d == 3) { digits = digits + "3"; }
        else if (d == 4) { digits = digits + "4"; }
        else if (d == 5) { digits = digits + "5"; }
        else if (d == 6) { digits = digits + "6"; }
        else if (d == 7) { digits = digits + "7"; }
        else if (d == 8) { digits = digits + "8"; }
        else if (d == 9) { digits = digits + "9"; }
        else if (d == 10) { digits = digits + "a"; }
        else if (d == 11) { digits = digits + "b"; }
        else if (d == 12) { digits = digits + "c"; }
        else if (d == 13) { digits = digits + "d"; }
        else if (d == 14) { digits = digits + "e"; }
        else if (d == 15) { digits = digits + "f"; }
        val = val / 16;
    }
    let result: str = "";
    if (n < 0) { result = "-"; }
    let dp: u64 = ptr(digits);
    let i: i32 = len(digits) - 1;
    while (i >= 0) {
        result = result + _byte_to_char(read_byte(dp + i32_to_u64(i)));
        i = i - 1;
    }
    return result;
}
