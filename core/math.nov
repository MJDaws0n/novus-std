// ---------------------------------------------------------------------------
// std/math - cross-platform numeric helpers (no assembly, no syscalls)
//
// Functions are overloaded by argument type, so call `abs(x)`, `min(a, b)`,
// `max(a, b)` without worrying about the underlying scalar type.
// ---------------------------------------------------------------------------

module std_math;

// ---------------------------------------------------------------------------
// abs - absolute value
// ---------------------------------------------------------------------------

fn abs(n: i32) -> i32 { if (n < 0) { return 0 - n; } return n; }
fn abs(n: i64) -> i64 { if (n < 0) { return 0 - n; } return n; }
fn abs(n: f32) -> f32 { if (n < 0.0) { return 0.0 - n; } return n; }
fn abs(n: f64) -> f64 { if (n < 0.0) { return 0.0 - n; } return n; }

// ---------------------------------------------------------------------------
// min / max
// ---------------------------------------------------------------------------

fn min(a: i32, b: i32) -> i32 { if (a < b) { return a; } return b; }
fn min(a: i64, b: i64) -> i64 { if (a < b) { return a; } return b; }
fn min(a: u32, b: u32) -> u32 { if (a < b) { return a; } return b; }
fn min(a: u64, b: u64) -> u64 { if (a < b) { return a; } return b; }
fn min(a: f32, b: f32) -> f32 { if (a < b) { return a; } return b; }
fn min(a: f64, b: f64) -> f64 { if (a < b) { return a; } return b; }

fn max(a: i32, b: i32) -> i32 { if (a > b) { return a; } return b; }
fn max(a: i64, b: i64) -> i64 { if (a > b) { return a; } return b; }
fn max(a: u32, b: u32) -> u32 { if (a > b) { return a; } return b; }
fn max(a: u64, b: u64) -> u64 { if (a > b) { return a; } return b; }
fn max(a: f32, b: f32) -> f32 { if (a > b) { return a; } return b; }
fn max(a: f64, b: f64) -> f64 { if (a > b) { return a; } return b; }

// ---------------------------------------------------------------------------
// clamp - constrain v into the inclusive range [lo, hi]
// ---------------------------------------------------------------------------

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn clamp(v: f32, lo: f32, hi: f32) -> f32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// ---------------------------------------------------------------------------
// sign - -1, 0 or 1 depending on the sign of the argument
// ---------------------------------------------------------------------------

fn sign(n: i32) -> i32 {
    if (n > 0) { return 1; }
    if (n < 0) { return 0 - 1; }
    return 0;
}
fn sign(n: i64) -> i32 {
    if (n > 0) { return 1; }
    if (n < 0) { return 0 - 1; }
    return 0;
}
fn sign(n: f32) -> i32 {
    if (n > 0.0) { return 1; }
    if (n < 0.0) { return 0 - 1; }
    return 0;
}
fn sign(n: f64) -> i32 {
    if (n > 0.0) { return 1; }
    if (n < 0.0) { return 0 - 1; }
    return 0;
}

// ---------------------------------------------------------------------------
// Parity helpers
// ---------------------------------------------------------------------------

fn is_even(n: i32) -> bool { return (n % 2) == 0; }
fn is_even(n: i64) -> bool { return (n % 2) == 0; }
fn is_odd(n: i32)  -> bool { return (n % 2) != 0; }
fn is_odd(n: i64)  -> bool { return (n % 2) != 0; }

// ---------------------------------------------------------------------------
// gcd / lcm (greatest common divisor / least common multiple)
// ---------------------------------------------------------------------------

fn gcd(a: i32, b: i32) -> i32 {
    let x: i32 = abs(a);
    let y: i32 = abs(b);
    while (y != 0) {
        let t: i32 = y;
        y = x % y;
        x = t;
    }
    return x;
}

fn lcm(a: i32, b: i32) -> i32 {
    if (a == 0 || b == 0) { return 0; }
    let g: i32 = gcd(a, b);
    return abs((a / g) * b);
}

// ---------------------------------------------------------------------------
// pow - integer exponentiation (exp < 0 yields 0 for integer bases)
// ---------------------------------------------------------------------------

fn pow(base: i32, exp: i32) -> i32 {
    if (exp < 0) { return 0; }
    let result: i32 = 1;
    let i: i32 = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

fn pow(base: i64, exp: i32) -> i64 {
    if (exp < 0) { return 0; }
    let result: i64 = 1;
    let i: i32 = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

fn pow(base: f64, exp: i32) -> f64 {
    let e: i32 = exp;
    if (e < 0) { e = 0 - e; }
    let result: f64 = 1.0;
    let i: i32 = 0;
    while (i < e) {
        result = result * base;
        i = i + 1;
    }
    if (exp < 0) { return 1.0 / result; }
    return result;
}

// ---------------------------------------------------------------------------
// factorial - n! as an i64 (n <= 1 returns 1; negative returns 1)
// ---------------------------------------------------------------------------

fn factorial(n: i32) -> i64 {
    if (n <= 1) { return 1; }
    let result: i64 = 1;
    let i: i32 = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Floating-point rounding and roots
// ---------------------------------------------------------------------------

fn floor(x: f64) -> f64 {
    let whole: i64 = f64_to_i64(x);
    let wf: f64 = i64_to_f64(whole);
    if (wf > x) { return wf - 1.0; }
    return wf;
}

fn ceil(x: f64) -> f64 {
    let whole: i64 = f64_to_i64(x);
    let wf: f64 = i64_to_f64(whole);
    if (wf < x) { return wf + 1.0; }
    return wf;
}

fn round(x: f64) -> f64 {
    if (x < 0.0) { return ceil(x - 0.5); }
    return floor(x + 0.5);
}

fn sqrt(x: f64) -> f64 {
    if (x <= 0.0) { return 0.0; }
    let guess: f64 = x;
    let i: i32 = 0;
    while (i < 40) {
        guess = (guess + x / guess) * 0.5;
        i = i + 1;
    }
    return guess;
}
