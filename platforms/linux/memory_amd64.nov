// ---------------------------------------------------------------------------
// std/memory_linux_amd64 - memory & buffer ops (Linux x86_64)
// Linux pipe() returns fds via memory buffer, not registers.
// ---------------------------------------------------------------------------

module std_memory_linux_amd64;

import ../../core/core;
import ../../core/strings;
import amd64;

fn make_buffer(size: i32) -> str {
    if (size <= 0) { return ""; }
    let buf: str = "        ";
    buf = buf + buf;
    while (len(buf) < size) {
        buf = buf + buf;
    }
    if (len(buf) > size) {
        buf[size] = 0;
    }
    return buf;
}

// Copy bytes from raw address to a new string (no pipe, byte-by-byte)
fn copy_bytes_raw(src: u64, length: i32) -> str {
    if (length <= 0) { return ""; }
    let buf: str = make_buffer(length);
    let i: i32 = 0;
    while (i < length) {
        buf[i] = read_byte(src + i32_to_u64(i));
        i = i + 1;
    }
    return buf;
}

fn copy_bytes(src: u64, length: i32) -> str {
    return copy_bytes_raw(src, length);
}

fn cstr_to_str(addr: u64) -> str {
    let slen: u64 = cstr_len(addr);
    if (slen == 0) { return ""; }
    return copy_bytes(addr, u64_to_i32(slen));
}

fn byte_at(s: str, i: i32) -> i32 {
    return read_byte(ptr(s) + i32_to_u64(i));
}

fn argv_get(argv: u64, index: i32) -> str {
    let offset: u64 = i32_to_u64(index) * 8;
    let addr: u64 = i64_to_u64(load64(argv + offset));
    return cstr_to_str(addr);
}

// Write a single byte to a raw memory address using the pipe trick
fn store8(addr: u64, val: i32) -> void {
    let tmp: str = "\0";
    tmp[0] = ((val % 256) + 256) % 256;

    let pipebuf: str = "\0\0\0\0\0\0\0\0";
    mov(rax, 22);      // SYS_pipe
    mov(rdi, pipebuf);
    syscall();
    let pb: u64 = ptr(pipebuf);
    let rfd: i32 = load32(pb);
    let wfd: i32 = load32(pb + 4);

    mov(rax, 1);       // SYS_write
    mov(rdi, wfd);
    mov(rsi, tmp);
    mov(rdx, 1);
    syscall();

    mov(rax, 3);       // SYS_close
    mov(rdi, wfd);
    syscall();

    mov(rax, 0);       // SYS_read
    mov(rdi, rfd);
    mov(rsi, addr);
    mov(rdx, 1);
    syscall();

    mov(rax, 3);       // SYS_close
    mov(rdi, rfd);
    syscall();
}

// Copy N bytes from src address to dst address using a single pipe
fn pipe_copy(src_addr: u64, dst_addr: u64, count: i32) -> void {
    if (count <= 0) { return; }
    let ucount: u64 = i32_to_u64(count);

    let pipebuf: str = "\0\0\0\0\0\0\0\0";
    mov(rax, 22);
    mov(rdi, pipebuf);
    syscall();
    let pb: u64 = ptr(pipebuf);
    let rfd: i32 = load32(pb);
    let wfd: i32 = load32(pb + 4);

    mov(rax, 1);
    mov(rdi, wfd);
    mov(rsi, src_addr);
    mov(rdx, ucount);
    syscall();

    mov(rax, 3);
    mov(rdi, wfd);
    syscall();

    mov(rax, 0);
    mov(rdi, rfd);
    mov(rsi, dst_addr);
    mov(rdx, ucount);
    syscall();

    mov(rax, 3);
    mov(rdi, rfd);
    syscall();
}

// Write a 32-bit value to a raw memory address (little-endian)
fn store32(addr: u64, val: i32) -> void {
    store8(addr, val % 256);
    store8(addr + 1, (val / 256) % 256);
    store8(addr + 2, (val / 65536) % 256);
    store8(addr + 3, (val / 16777216) % 256);
}

// Fill a memory region with a byte value
fn memset(addr: u64, val: i32, count: i32) -> void {
    let i: i32 = 0;
    while (i < count) {
        store8(addr + i32_to_u64(i), val);
        i = i + 1;
    }
}
